# ==========================================
# DepanceAPP - Coolify Environment Configuration
# ==========================================
# In Coolify:
# 1. Add New Resource -> Docker Compose -> Git Repository
# 2. Select `docker-compose.coolify.yml` as the compose file
# 3. Paste or customize the environment variables below in Coolify UI
# ==========================================

# Database credentials (managed inside the Docker Compose stack)
DB_USER=depance
DB_PASSWORD=replace_with_strong_password
DB_NAME=depance_db
DB_ROOT_PASSWORD=replace_with_strong_root_password

# Authentication Secrets (recommended for persistent sessions across redeploys)
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

# Domains & Reverse Proxy
# Coolify automatically sets COOLIFY_URL / COOLIFY_FQDN.
# If custom, specify your public URL (e.g. https://depance.yourdomain.com):
APP_URL=https://depance.yourdomain.com
ALLOWED_ORIGINS=https://depance.yourdomain.com

# Traefik Reverse Proxy Trust (auto-enabled when COOLIFY_URL/COOLIFY_FQDN is present)
TRUST_PROXY=true

# Runtime & API Docs
NODE_ENV=production
ENABLE_API_DOCS=false

# Backups (Optional)
RETENTION_DAYS=7
# BACKUP_ENCRYPTION_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
