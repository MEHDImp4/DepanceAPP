{
  "expo": {
    "name": "DepanceAPP",
    "slug": "depance-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "depance",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Autoriser DepanceAPP à protéger votre session."
        }
      ]
    ],
    "android": {
      "package": "com.mehdimp4.depanceapp"
    },
    "ios": {
      "bundleIdentifier": "com.mehdimp4.depanceapp",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
