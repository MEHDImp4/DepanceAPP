# ==========================================
# DepanceAPP Configuration
# ==========================================

APP_PORT=3000
APP_URL=http://localhost:3000

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=depance_db
DB_USER=depance
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# Optional full Prisma URL. When set, it overrides the DB_* connection variables.
# DATABASE_URL=mysql://depance:change_me_db_password@db:3306/depance_db

# Authentication secrets
# Generate each value independently, for example with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

# Legacy local-development fallback only. Leave unset in production.
# JWT_SECRET=

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Reverse proxy / CORS
# In the production Docker stack the app receives one trusted proxy hop by default.
TRUST_PROXY=1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API documentation is enabled automatically outside production.
# Set to true explicitly if you want /api-docs exposed in production.
ENABLE_API_DOCS=false

# ==========================================
# Backup Configuration (Optional)
# ==========================================

BACKUP_DIR=./backups
RETENTION_DAYS=7
# Required only with server/scripts/backup.sh --encrypt
BACKUP_ENCRYPTION_KEY=replace_with_a_strong_backup_key

# Required only with server/scripts/backup.sh --s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
